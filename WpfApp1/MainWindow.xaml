<Window x:Class="_2026_WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2026_WpfApp2"
        mc:Ignorable="d"
        Title="WPF飲料訂購ver3" Height="471" Width="832">
    <Grid Margin="5,5,5,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="240"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="533"/>
            <ColumnDefinition MinWidth="100" />
        </Grid.ColumnDefinitions>
        <GroupBox Header="內用/外帶">
            <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2" Background="Bisque">
                <RadioButton x:Name="RadioButton1" Content="內用" Margin="80,0,0,0" FontSize="14" FontWeight="Bold" VerticalContentAlignment="Center" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="RadioButton2" Content="外帶" Margin="80,0,0,0" FontSize="14" FontWeight="Bold" VerticalContentAlignment="Center" Checked="RadioButton_Checked"/>
            </StackPanel>
        </GroupBox>
        <StackPanel x:Name="DrinkMenuStackPanel" Orientation="Vertical" Grid.Row="1" Background="#FFF1F5E8">
        </StackPanel>
        <TextBlock x:Name="ResultTextBlock"  Grid.Row="2" TextWrapping="Wrap" Background="#FFFBEEE5" Grid.ColumnSpan="2" FontSize="14" Padding="10,10,10,10" Grid.RowSpan="1"/>
        <Button x:Name="OrderButton" Grid.Column="1" Content="訂購" Grid.Row="1" FontSize="16" Click="OrderButton_Click" MinWidth="50" Margin="34,68,34,135"/>
    </Grid>
</Window>
